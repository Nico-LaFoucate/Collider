REGEDIT4

; Neutron: dark client-side window decoration colors for Adobe Premiere (and Adobe
; suite). Applied to the Wine prefix so Wine draws a dark title bar + menu bar that
; matches Premiere's chrome. Apply with:  wine regedit neutron-premiere-dark.reg
[HKEY_CURRENT_USER\Control Panel\Colors]
"ActiveTitle"="43 43 43"
"GradientActiveTitle"="43 43 43"
"TitleText"="224 224 224"
"InactiveTitle"="32 32 32"
"GradientInactiveTitle"="32 32 32"
"InactiveTitleText"="140 140 140"
"ActiveBorder"="43 43 43"
"InactiveBorder"="32 32 32"
"WindowFrame"="20 20 20"
"Menu"="43 43 43"
"MenuText"="224 224 224"
"MenuBar"="43 43 43"
"MenuHilight"="64 64 64"
"HilightText"="255 255 255"
"Window"="43 43 43"
"WindowText"="224 224 224"
